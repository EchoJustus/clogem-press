   :package      "simple-icons"
   :version      "16.34.0"
   :tarball      "https://registry.npmjs.org/simple-icons/-/simple-icons-16.34.0.tgz"
   :sha256       "25887ddf96a084a82f9181dc3a7e99750d6b5ac4339fe9321d0e2bf14669dc65"
   :license      "CC0-1.0 (brand marks remain their owners' trademarks; see the disclaimer)"
   :license-file "LICENSES/simple-icons-CC0-1.0.md"
   :disclaimer   "LICENSES/simple-icons-DISCLAIMER.md"}
  :tabler
  {:name         "Tabler Icons"
