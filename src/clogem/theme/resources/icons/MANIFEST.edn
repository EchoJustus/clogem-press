;; Vendored icon sources (DESIGN.md §11.3 item 6, D-P4-6). Read by clogem.sprite,
;; which builds dist/clogem/icons.svg from these files; nothing here ships as is.
;;
;; Each source is pinned to an exact upstream release. The sha256 is that of the
;; npm tarball the files were copied from, unmodified (the sprite builder strips
;; titles, comments and Tabler's invisible bounding-box path when it builds).
;; To update: `npm pack <package>@<version>`, check the sha256, copy the files,
;; bump :version, :tarball and :sha256 here.
{:sources
 {:lucide
  {:name         "Lucide"
   :package      "lucide-static"
   :version      "1.52.0"
   :tarball      "https://registry.npmjs.org/lucide-static/-/lucide-static-1.52.0.tgz"
   :sha256       "4d2aa079171e4eba4c704844b8b0c9edb6e4cfb2fb8bd86f7b14353994f04a87"
   :license      "ISC; icons derived from Feather are also MIT"
