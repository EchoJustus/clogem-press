;; clogem-press — annotated reference config.
;;
;; Copy to `site.edn` in your content repo. Every key shown here has the value
;; clogem-press would use if you omitted it, so this file doubles as the schema
;; and as the documentation of the defaults. Section references are to DESIGN.md.
;;
;; Any string-valued key may be either a plain string (same in all languages) or
;; a map keyed by language code. The §6.5 fallback chain applies uniformly:
;;
;;     requested lang → :i18n :fallback (default [:site-default :en]) → the map's first value
;;
;; so there is exactly one rule to learn. (A map with none of the chain's
;; languages resolves to its FIRST value — `{:ta "…" :zh-Hans "…"}` shows the
;; Tamil one to an English reader. It is the theme's own UI strings, `i18n/<lang>.edn`,
;; whose chain ends in the key itself.)
;;
;; A key clogem-press does not know is a WARNING naming its path and the
;; nearest known key (`bb doctor` lists them); so is vdoing's camelCase spelling
;; of one (`pageStyle` → :theme :page-style), and a key that is documented but
;; not implemented yet. Never an error.

{;; ---------------------------------------------------------------- site ----
 :site {:title       {:en "My knowledge base" :zh-Hans "我的知识库"}
        :description {:en "Notes, guides, and a blog."}
        :url         "https://example.github.io"   ; no trailing slash; used for
                                                   ; canonical/hreflang/feeds/sitemap/
                                                   ; robots.txt — blank skips them all
                                                   ; (a warning, not an error)
        :base        "/"                           ; "/project/" for a project site
        :author      {:name "Your Name" :link "https://github.com/you"}}

 ;; ----------------------------------------------------------- generator ----
 ;; D-14, as amended in v2.1: the AUTHORITATIVE version pin is the `ref:` in
 ;; your publish.yml, because the checkout has already happened by the time the
 ;; generator reads this file. What lives here is documentation plus an optional
 ;; compatibility FLOOR, which the build asserts against its own baked-in
 ;; version and HARD-FAILS on. That catches the real skew — "content started
 ;; using a convention the pinned generator does not have yet" — and stays
 ;; correct whether the workflow pins a tag, a branch, or a sha.
 :generator {:repo "EchoJustus/clogem-press"
             ;; :min-version "0.3.0"   ; a quoted MAJOR.MINOR.PATCH(-pre)? string;
             ;;                          ; semver precedence, so a pre-release
             ;;                          ; generator is BELOW its release
             }

 ;; --------------------------------------------------------------- langs ----
 :langs {:default  :en
         ;; Per-article default-version order. The bare /pages/xxxxxx/ URL
         ;; serves the first language in this list that the article ACTUALLY
         ;; HAS — not a site-wide default (§6.3). That is the one point where
         ;; this design diverges from every generator surveyed, and it exists so
         ;; an article with no English version is still reachable at its
         ;; identity URL.
         :priority [:en :zh-Hans :zh-Hant :ms :ta]
         ;; The five defaults are always merged in; to run a site with FEWER
         ;; languages set the unwanted ones to nil: {:ms nil :ta nil}.
         :locales
         {:en      {:label "English"       :html-lang "en"      :giscus "en"    :dir :ltr :og "en_US"}
          :zh-Hans {:label "简体中文"       :html-lang "zh-Hans" :giscus "zh-CN" :dir :ltr :og "zh_CN"}
          :zh-Hant {:label "繁體中文"       :html-lang "zh-Hant" :giscus "zh-TW" :dir :ltr :og "zh_TW"}
          ;; :giscus for ms/ta MUST be "en". giscus has no locale for either,
          ;; and data-lang is routed into the widget's iframe URL — an
          ;; unroutable value 404s the iframe and NO comment widget renders.
          ;; Validated at build time (§6.8, v2.1 V12).
          :ms      {:label "Bahasa Melayu" :html-lang "ms"      :giscus "en"    :dir :ltr :og "ms_MY"}
          :ta      {:label "தமிழ்"          :html-lang "ta"      :giscus "en"    :dir :ltr :og "ta_IN"}}}
         ;; :og is og:locale — ogp.me's language_TERRITORY, validated (§6.6)

 ;; ---------------------------------------------------------------- i18n ----
 :i18n {:strings-dir   "i18n"     ; <lang>.edn, deep-merged over theme defaults
        ;; false → the primary variant lives at the bare /pages/xxxxxx/ and only
        ;; non-primary variants get a /<lang>/ prefix. true → every variant is
        ;; prefixed and the bare URL becomes a redirect stub, so existing links
        ;; are REDIRECTED, not broken (D-10).
        :prefix-default? false
        ;; tried after the requested language; configured language keywords
        ;; or :site-default (= :langs :default). A bad value is a config error.
        :fallback      [:site-default :en]
        :missing-key   :warn      ; :warn (once per key and language, build and dev) | :silent
        ;; Display-only (D-12): category KEYS stay the raw directory-derived
        ;; names and are the URL slugs; labels localize what is shown.
        :category-labels {}       ; e.g. {"Basics" {:zh-Hans "基础"}}
        :show-fallback-notice true
        ;; What a reader's stored language choice (set by a click on the navbar
        ;; switcher or the per-article variant bar, and only by those) does on
        ;; a page served at its BARE URL (§6.4, D-11): :banner offers "also
        ;; available in <L>" in L; :redirect replaces the page with its L
        ;; variant before it paints (dropping any #hash or ?query — anchors
        ;; differ per language); :ignore does neither. Anything else is a
        ;; config error.
        :preference :banner}

 ;; ------------------------------------------------------------- content ----
 :content {:dir "content"
           :assets-dir "assets"
           ;; The three index systems. false removes the index pages AND the
           ;; matching @pages/ auto-creation (a docs site sets all three false).
           :category true :tag true :archive true
           :category-text "Notes"        ; category for _posts/ with no subfolder
           :extend-frontmatter {}        ; extra keys auto-fill should write
           :permalink-prefix "/pages/"
           :permalink-length 6           ; vdoing's 6 hex chars; older vdoing
                                         ; emitted 16, so treat permalinks as opaque
           ;; true → the build writes missing front matter into your source
           ;; files (vdoing's behaviour, and what makes `git mv` URL-safe).
           ;; false → a purely read-only build; URLs then come from
           ;; permalinks.edn, falling back to a deterministic hash (§7.2).
           :write-front-matter true
           :permalinks-file "permalinks.edn"}

 ;; --------------------------------------------------------------- theme ----
 ;; Colour modes (§11.3 items 2–4): the mode a FIRST visit sees. The navbar's
 ;; mode button lets the reader choose; the choice is kept in localStorage
 ;; ("clogem-mode") and beats this. :auto follows the OS (live, and without
 ;; JS through a media query); :read is a sepia page with a dark code block.
 ;; The classes are on <html>: `.theme-mode-dark`, `.theme-style-card`.
 ;;
 ;; Your own CSS: overrides/custom.css (beside site.edn) ships as
 ;; dist/clogem/overrides/custom.css, cache-busted, linked LAST — after the
 ;; theme's and Pagefind's stylesheets. Write `.theme-mode-dark { … }`, not
 ;; `body.theme-mode-dark` (0.2.0's classes were on <body>).
 :theme {:default-mode :auto          ; :auto | :light | :dark | :read; anything else
                                      ; is a config error (giscus starts :read as light)
         :page-style   :card          ; :card | :line — vdoing's pageStyle; anything else
                                      ; warns and falls back to :card (B2 styles them)
         :sidebar-open true           ; true → every sidebar group starts open;
                                      ; false → only the current article's trail
                                      ; (vdoing's `sidebar.collapsable`, inverted; vdoing's
                                      ; `sidebarOpen` is the planned :sidebar-collapsed)
         :sidebar-depth 2             ; right-hand TOC depth, an integer 0–5: 0 = no TOC,
                                      ; 1 = h2, 2 = h2–h3, 3 = h2–h4; front matter
                                      ; `sidebarDepth:` overrides per page
         :per-page 10                 ; a positive integer: articles per page on the
                                      ; homepage and on category / tag pages (/page/2/, …)
         :fonts {:tamil :system}      ; :system | :self-hosted  (§6.9, D-P3-12)
                                      ; :self-hosted ships subset Noto Sans Tamil
                                      ; 400/700 woff2 (~24 KB each, SIL OFL) and
                                      ; links clogem/fonts/tamil.css; :system
                                      ; ships no font bytes at all
         :html-modules {}}            ; raw HTML for vdoing's 7 slots (Phase 4 Task E1);
                                      ; anything here warns: no effect in 0.2.0

 :nav [{:text {:en "Home" :zh-Hans "首页"} :link "/"}]

 ;; -------------------------------------------------------------- search ----
 :search {:provider :none}   ; :none | :pagefind (§6.7, D-P3-8 … D-P3-10).
                             ; :pagefind runs the EXTENDED binary over dist/
                             ; at the end of `build` (`--no-search` builds
                             ; with no index and no search UI at all),
                             ; one index per <html lang>, only article and
                             ; catalogue bodies indexed. A failed fetch or a
                             ; non-zero exit fails the build (exit 1).
                             ; Cross-language search (pagefind.mergeIndex) is
                             ; deferred to Phase 4 (D-P3-11).

 ;; ----------------------------------------------------------- highlight ----
 ;; §11.3 item 10: code blocks are highlighted by Chroma at build time — ON BY
 ;; DEFAULT. The first build of a site with a code block fetches Chroma (a 3 MB
 ;; download, 8.4 MB unpacked; sha256-verified, cached outside the site under
 ;; :tools below); a
 ;; failed fetch or a failed Chroma run fails `build` (exit 1) and only warns
 ;; in `bb dev`. `--no-highlight` (build, dev) or :provider :none renders code
 ;; as plain <pre><code>. Every bad value here is a warning, and the default
 ;; is used.
 :highlight {:provider     :chroma   ; :chroma | :none
             :line-numbers true      ; drawn by CSS, never copied or indexed;
                                     ; ```js:no-line-numbers / ```js:line-numbers
                                     ; override it for one block
             :copy-button  true      ; js/code.js: a copy button where the
                                     ; browser has the clipboard API
             :style        "github"        ; light mode (and print)
             :dark-style   "github-dark"}  ; dark AND reading mode (its code
                                           ; block is dark). Any style
                                           ; `chroma --list` names; each must
                                           ; keep tokens at 4.5:1 on the
                                           ; theme's --codeBg — the defaults do
 ;; Fences: ```clojure, ```clj, ```edn — a lexer's name, alias or file
 ;; extension. ```js{1,3-5} or ```js {2} highlights lines. An unknown
 ;; language is plain text, with one warning per language per build.

 ;; --------------------------------------------------------------- tools ----
 ;; D-P3-8: fetched over HTTPS (honouring HTTPS_PROXY / HTTP_PROXY, NO_PROXY,
 ;; and user:pass@ in the proxy URL), sha256-checked against a per-platform
 ;; pin, unpacked and cached OUTSIDE the site, in
 ;; $XDG_CACHE_HOME/clogem-press/tools/<tool>/<version>/<platform>/ (else
 ;; ~/.cache/…), stamped with the hashes it was verified against and
 ;; re-checked on every use. `bb fetch-tool` does just that and prints the
 ;; binary's path; `--tool chroma` or `--tool fswatcher` fetches the others.
 ;; Each tool takes the same four keys — :version, :sha256 (a map, one hash per
 ;; platform), :path (a preinstalled binary, relative to the site; skips
 ;; download and verification) and :url (a mirror; {{version}} and
 ;; {{platform}} are filled in) — and an environment variable, relative to the
 ;; working directory, that beats :path.
 :tools {:pagefind {:version "1.5.2"}  ; its six platform hashes are built in
         ;; pinning another version? give every platform you build on its hash
         ;; from the release's .sha256 files:
         ;; :pagefind {:version "1.5.2"
         ;;            :sha256 {"x86_64-unknown-linux-musl"  "aeb1…"
         ;;                     "aarch64-unknown-linux-musl" "3f66…"
         ;;                     "x86_64-apple-darwin"        "3523…"
         ;;                     "aarch64-apple-darwin"       "99c4…"
         ;;                     "x86_64-pc-windows-msvc"     "7ba2…"
         ;;                     "aarch64-pc-windows-msvc"    "4fd4…"}
         ;;            :path "/usr/local/bin/pagefind_extended"  ; relative to the site; or env
         ;;                                                      ; CLOGEM_PAGEFIND (relative to the cwd):
         ;;                                                      ; skips download + verification
         ;;            :url  "https://mirror.example/v{{version}}/pagefind_extended-v{{version}}-{{platform}}.tar.gz"}
         ;; Chroma, the syntax highlighter (MIT), run by `build` under
         ;; :highlight {:provider :chroma}. Env CLOGEM_CHROMA. Its eight platform
         ;; hashes are built in, from upstream's chroma-2.27.0-checksums.txt:
         ;; {linux,darwin,windows}-{amd64,arm64}, linux-386, windows-386. A bad
         ;; pin here is an error, as for :pagefind. The styles are not set here:
         ;; they are :highlight :style and :dark-style.
         :chroma {:version "2.27.0"}
         ;; :chroma {:version "2.27.0"
         ;;          :sha256 {"linux-amd64" "91e1…" "darwin-arm64" "92f4…"}
         ;;          :path   "/usr/local/bin/chroma"}
         ;; The org.babashka/fswatcher pod `bb dev` will watch with (Phase 4
         ;; Task D). Env CLOGEM_FSWATCHER. One zip per platform — linux-amd64,
         ;; linux-aarch64, macos-amd64, macos-aarch64, windows-amd64 — with its
         ;; hashes built in; upstream publishes none, so these were taken from
         ;; the release zips on 2026-10-02 (trust on first use, DESIGN.md §11.3
         ;; item 12).
         :fswatcher {:version "0.0.7"}
         ;; :cache-dir ".tools"         ; relative to the site; env CLOGEM_TOOLS_DIR wins
         }

 ;; ------------------------------------------------------------ comments ----
 :comments {:provider :none}   ; :none | :giscus
 ;; :comments {:provider    :giscus
 ;;            :repo        "you/your.github.io"  ; owner/name, not a URL
 ;;            :repo-id     "R_…"             ; all four are required; copy them
 ;;            :category    "Announcements"   ; from https://giscus.app
 ;;            :category-id "DIC_…"}
 ;; Every article variant gets data-mapping="specific" with data-term = its
 ;; bare permalink (/pages/xxxxxx/), so all languages share ONE thread;
 ;; data-lang is the locale's :giscus; data-theme follows :theme
 ;; :default-mode. `comment: false` on the primary variant turns it off for
 ;; that article. There is no :mapping option (threads are always keyed on the
 ;; permalink); `:mapping :permalink` is accepted, any other key warns.
 ;; A strict CSP needs script-src, frame-src AND style-src https://giscus.app:
 ;; client.js links https://giscus.app/default.css into the host page.
 ;;
 ;; Migrating discussions that predate giscus? Strict mode matches a
 ;; `<!-- sha1: <hash-of-term> -->` marker in the discussion BODY, not the
 ;; title, so retitling alone leaves the thread invisible and lets the next
 ;; comment open a duplicate. See §6.8 / §7.4 step 8.

 :analytics {:provider :none}   ; :ga4 | :plausible | :umami   (D-13; Phase 4 Task F)
                                ; anything but :none warns: no effect in 0.2.0

 :seo {:sitemap true :hreflang true
       :x-default :primary      ; x-default → the bare identity URL; the only value
       :feeds   true            ; /feed.xml + /<lang>/feed.xml, Atom (§6.6)
       :indexnow {:enabled false :key nil}}   ; the push is Phase 5; :enabled true
                                               ; warns: no effect in 0.2.0

 ;; --------------------------------------------------------------- build ----
 ;; Every page is rendered in memory, and every site asset read, before
 ;; anything is written, so a render or read failure leaves dist/ and
 ;; permalinks.edn untouched. Then each file is written through a temp file
 ;; and a rename (in place if the OS refuses either), and only when its bytes
 ;; changed, so a no-change rebuild writes nothing. An I/O failure while
 ;; writing (a full disk), or a Pagefind failure, can leave some files updated.
 ;; Pages render in parallel, one worker per processor; the environment
 ;; variable CLOGEM_JOBS sets the number (CLOGEM_JOBS=1: one thread, as in
 ;; 0.2.0). The output is byte-identical either way.
 :build {:out "dist"}}  ; a directory of its own: a build removes .html files
                         ; in it that it did not write (§11.2 item 46)
