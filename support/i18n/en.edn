              :href   "https://github.com/EchoJustus/clogem-press/pulls"
              :action "Pull requests"}
             {:chip   "Q&A"
              :title  "Ask a question"
              :text   ["How to do something with clogem-press, or why it works the way it does."]
              :href   "https://github.com/EchoJustus/clogem-support/discussions/new?category=q-a"
