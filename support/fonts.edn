;;
;; The support page's fonts (DESIGN.md §7.5; README, "Support page"): the
;; one place their pins live. `bb support-fonts` prints them as lines for
;; support/fonts.sh, which downloads each file, checks its SHA-256, cuts
;; the subsets below from it with pyftsubset and publishes them, with the
;; licences, as clogem-press/fonts/. support-page/font-plan reads this file;
;; test/clogem/support_page_test.clj checks it.
;;
;; :fonts      each font: its family name in the pages' CSS, its repository,
;;             the release tag, and per weight the release's TTF (:url, its
;;             SHA-256); :licence is the repository's OFL.txt at that tag,
;;             published beside the subsets as :as (OFL condition 2).
;;             SIL OFL 1.1, derived from Fontworks' Klee One. Only Regular
;;             (400) and Medium (500) are used: the font has no face
;;             between or above them that the page needs, and
;;             the CSS never asks for another weight (no faux bold).
;; :pages      the pages whose text is in LXGW WenKai: English and the two
;;             Chinese ones (the owner, 2026-10-26). zh-Hant takes the main
;;             WenKai's own Traditional glyphs. pt-BR and es-ES keep the
;;             system's fonts and load no font file; Portuguese and Spanish
;;             words on the WenKai pages (the switcher's names) do too.
;; :subsets    each subset the pages may use, by id (the file is
;;             fonts/<id>.woff2, its character list dist-support/glyphs/<id>.txt):
;;             the font and weight it is cut from, and its size cap in bytes,
;;             set from measurement at v1.530 (README, "Support page": about
;;             twice each subset's size then, more for the small ones);
;;             fonts.sh fails a subset over its cap.
{:fonts
 {:wenkai
  {:family  "LXGW WenKai"
   :repo    "https://github.com/lxgw/LxgwWenKai"
   :tag     "v1.530"
   :faces   {400 {:url    "https://github.com/lxgw/LxgwWenKai/releases/download/v1.530/LXGWWenKai-Regular.ttf"
                  :sha256 "2d73eea94ad808999d90c0000c239a84a33b09d4bc6ab6c5b8bbf1eda8a7fc8b"}
             500 {:url    "https://github.com/lxgw/LxgwWenKai/releases/download/v1.530/LXGWWenKai-Medium.ttf"
                  :sha256 "f4b8a34d1f838fe411540cb7c97b1c384ac9738a876c4104500bc42508b2312a"}}
   :licence {:url    "https://raw.githubusercontent.com/lxgw/LxgwWenKai/v1.530/OFL.txt"
             :sha256 "1a25e35da1031c6c3436fde545bb9cb5aca954e9873afe510c834b8b79bd21a0"
             :as     "OFL-LXGW-WenKai.txt"}}}

 :pages ["en" "zh-Hant" "zh-Hans"]

 :subsets
 {;; Latin (below U+2E80, but for "…", which English leaves to the
  ;; system: WenKai draws it centred, as Chinese sets it) for the three pages
  "wenkai-latin-400" {:font :wenkai :weight 400 :cap 40960}
  "wenkai-latin-500" {:font :wenkai :weight 500 :cap 40960}
  ;; the zh-Hans page's Chinese (and the switcher's 繁體中文 there)
  "wenkai-sc-400"    {:font :wenkai :weight 400 :cap 163840}
  "wenkai-sc-500"    {:font :wenkai :weight 500 :cap 32768}
  ;; the zh-Hant page's Chinese (and the switcher's 简体中文 there)
  "wenkai-hant-400"  {:font :wenkai :weight 400 :cap 212992}
  "wenkai-hant-500"  {:font :wenkai :weight 500 :cap 36864}
  ;; the English page's Chinese: the switcher's 繁體中文 and 简体中文
  "wenkai-names-500" {:font :wenkai :weight 500 :cap 8192}}}
