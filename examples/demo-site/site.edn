;; clogem-press demo site — the executable specification of the conventions.
;;
;; CI builds this on every push (the convention-regression tripwire from
;; DESIGN.md §10). It is deliberately multilingual and deliberately contains an
;; article with NO English version, so the priority-fallback path of §6.3 is
;; exercised continuously rather than only when someone remembers to.
{:site {:title {:en      "clogem-press demo"
                :zh-Hans "clogem-press 演示"
                :zh-Hant "clogem-press 示範"
                :ms      "Demo clogem-press"
                :ta      "clogem-press விளக்கம்"}
        :description {:en "A five-language fixture exercising every content convention."
                      :zh-Hans "覆盖全部内容约定的五语言示例。"}
        :url  "https://clogem-demo.example"   ; .example is reserved (RFC 2606): no canonicals on a real domain
        :base "/"}

 ;; D-14 / v2.1 M3: no :ref here. publish.yml's `ref:` is the authoritative pin;
 ;; what site.edn carries is a compatibility floor the build asserts.
 :generator {:repo "EchoJustus/clogem-press"}

 :langs {:default  :en
         :priority [:en :zh-Hans :zh-Hant :ms :ta]
         :locales
         {:en      {:label "English"        :html-lang "en"      :giscus "en"    :dir :ltr}
          :zh-Hans {:label "简体中文"        :html-lang "zh-Hans" :giscus "zh-CN" :dir :ltr}
          :zh-Hant {:label "繁體中文"        :html-lang "zh-Hant" :giscus "zh-TW" :dir :ltr}
          ;; giscus has no ms/ta locale, and data-lang is routed into the widget
          ;; iframe URL — an unroutable value 404s it. Mapping to "en" is
          ;; mandatory, not cosmetic (DESIGN.md §6.8, v2.1 V12).
          :ms      {:label "Bahasa Melayu"  :html-lang "ms"      :giscus "en"    :dir :ltr}
          :ta      {:label "தமிழ்"           :html-lang "ta"      :giscus "en"    :dir :ltr}}}

 :i18n {:strings-dir "i18n"
        :prefix-default? false          ; D-10: primary variant at the bare /pages/…/
        :missing-key :warn
        ;; D-12: display-only labels; the category key and URL slug stay "Basics"
        :category-labels {"Basics" {:zh-Hans "基础" :zh-Hant "基礎"}}
        :show-fallback-notice true}

 :content {:dir "content"
           :permalink-prefix "/pages/"
           :write-front-matter true
           :permalinks-file "permalinks.edn"
           :assets-dir "assets"}

 ;; D-P2-11: site pages are prefixed per language (`/` → `/zh-Hans/`), a
 ;; permalink resolves to the reader's variant, and :items makes a dropdown.
 ;; A parent may carry both :link (conventionally a catalogue page) and :items.
 :nav [{:text {:en "Home" :zh-Hans "首页" :zh-Hant "首頁" :ms "Laman utama" :ta "முகப்பு"} :link "/"}
       {:text {:en "Guide" :zh-Hans "指南" :zh-Hant "指南" :ms "Panduan" :ta "வழிகாட்டி"}
        :link "/pages/559f0f/"
        :items [{:text {:en "Deep" :zh-Hans "深层"} :link "/pages/c4d33p/"}]}
       {:text {:en "Browse" :zh-Hans "浏览" :zh-Hant "瀏覽" :ms "Semak imbas" :ta "உலாவு"}
        :items [{:text {:en "Categories" :zh-Hans "分类" :zh-Hant "分類" :ms "Kategori" :ta "பிரிவுகள்"} :link "/categories/"}
                {:text {:en "Tags" :zh-Hans "标签" :zh-Hant "標籤" :ms "Tag" :ta "குறிச்சொற்கள்"} :link "/tags/"}
                {:text {:en "Archives" :zh-Hans "归档" :zh-Hant "歸檔" :ms "Arkib" :ta "காப்பகம்"} :link "/archives/"}]}]

 :theme {:default-mode :auto :page-style :card
         :per-page 3}                    ; small, so the demo has a /page/2/
 :search   {:provider :none}
 :comments {:provider :none}}
